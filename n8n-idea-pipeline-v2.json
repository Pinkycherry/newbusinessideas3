    {
      "parameters": {
        "jsCode": "const inputData = $input.item.json;\nlet rawText = inputData.text || inputData.output || (typeof inputData === 'string' ? inputData : JSON.stringify(inputData));\nconst cleaned = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet g = null;\ntry { g = JSON.parse(cleaned); } catch (e) { g = null; }\n\nlet src = {};\ntry { src = $('Loop Over Items').item.json; } catch (err) { src = {}; }\n\n// Pass Claude/seed fields straight through, untouched.\nconst pass = {\n  idea_id: src.idea_id || \"\",\n  category_id: src.category_id || \"\",\n  category_name: src.category_name || \"\",\n  category_slug: src.category_slug || \"\",\n  subcategory_id: src.subcategory_id || \"\",\n  subcategory_name: src.subcategory_name || \"\",\n  subcategory_slug: src.subcategory_slug || \"\",\n  focus_keyword: src.focus_keyword || \"\",\n  additional_keyword_1: src.additional_keyword_1 || \"\",\n  additional_keyword_2: src.additional_keyword_2 || \"\",\n  business_description: src.business_description || \"\",\n  collection_id: src.collection_id || \"\",\n  title: src.title || \"\",\n  slug: src.slug || \"\",\n  seo_title: src.seo_title || \"\",\n  meta_description: src.meta_description || \"\",\n  tags: src.tags || \"[]\",\n  external_links: src.external_links || \"[]\",\n  internal_link_anchors: src.internal_link_anchors || \"[]\",\n  research_facts: src.research_facts || \"{}\"\n};\n\n// If Gemini failed, mark for retry but KEEP all of Claude's work intact.\nif (!g || !g.summary) {\n  return { json: { ...pass, status: \"needs_retry\" } };\n}\n\nconst str = (v) => (v === undefined || v === null) ? \"\" : String(v);\nconst arr = (v) => Array.isArray(v) ? JSON.stringify(v) : (typeof v === 'string' ? v : JSON.stringify(v || []));\nconst trend = parseInt(g.trend_score, 10) || 70;\nconst tier = g.tier || (trend >= 88 ? \"premium\" : \"free\");\n\nreturn {\n  json: {\n    ...pass,\n    summary: str(g.summary),\n    market_opportunity: str(g.market_opportunity),\n    target_customer: str(g.target_customer),\n    how_you_make_money: str(g.how_you_make_money),\n    startup_cost: str(g.startup_cost),\n    income_potential: str(g.income_potential),\n    competition_edge: str(g.competition_edge),\n    getting_started_steps: arr(g.getting_started_steps),\n    tools_needed: arr(g.tools_needed),\n    time_to_first_customer: str(g.time_to_first_customer),\n    faq_json: arr(g.faq_json),\n    pros_json: arr(g.pros_json),\n    cons_json: arr(g.cons_json),\n    verdict: str(g.verdict),\n    trend_score: trend,\n    tier: tier,\n    status: \"completed\"\n  }\n};"
      },
