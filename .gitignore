node_modules

# bun is the only package manager (Cloudflare runs bun install --frozen-lockfile).
# Other lockfiles drift from bun.lock and break the deploy.
package-lock.json
yarn.lock
pnpm-lock.yaml
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Claude agent worktrees (local tooling, not project source)
.claude/worktrees/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — never commit credentials to the repo
LOGIN_CREDENTIALS_AND_API_KEYS.md

# scrollcraft local workspace (tool-generated, not app source)
/scrollcraft/

# Local Supabase stand-in for sandbox verification. Holds mock idea data, so it
# stays out of version control — nothing here may become a source of truth.
.localdev/
