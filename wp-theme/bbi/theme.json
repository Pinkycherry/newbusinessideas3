{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "48rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"customDuotone": true,
			"palette": [
				{ "slug": "primary", "name": "Brand primary", "color": "#4643BA" },
				{ "slug": "accent", "name": "Accent", "color": "#4643BA" },
				{ "slug": "background", "name": "Page background", "color": "#FCFBFE" },
				{ "slug": "background-2", "name": "Background, alternate", "color": "#EEECF8" },
				{ "slug": "foreground", "name": "Body text", "color": "#0C0C25" },
				{ "slug": "muted-foreground", "name": "Secondary text", "color": "#3A3697" },
				{ "slug": "hl-gold", "name": "Highlight — gold", "color": "#8A5D00" },
				{ "slug": "hl-green", "name": "Highlight — green", "color": "#0F6E44" },
				{ "slug": "hl-coral", "name": "Highlight — coral", "color": "#B0442C" },
				{ "slug": "hl-teal", "name": "Highlight — teal", "color": "#10627A" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			],
			"gradients": [
				{ "slug": "brand-sweep", "name": "Brand sweep", "gradient": "linear-gradient(135deg, #4643BA 0%, #8886DB 100%)" },
				{ "slug": "dawn", "name": "Dawn", "gradient": "linear-gradient(135deg, #B0442C 0%, #8A5D00 100%)" },
				{ "slug": "deep", "name": "Deep", "gradient": "linear-gradient(135deg, #10627A 0%, #0F6E44 100%)" },
				{ "slug": "paper", "name": "Paper", "gradient": "linear-gradient(180deg, #FCFBFE 0%, #EEECF8 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "var(--font-display, \"Instrument Serif\", ui-serif, Georgia, serif)"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "var(--font-sans, \"Inter\", ui-sans-serif, system-ui, sans-serif)"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "eyebrow", "name": "Eyebrow", "size": "0.6875rem" },
				{ "slug": "meta", "name": "Meta", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "lead", "name": "Lead", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "card", "name": "Card heading", "size": "1.125rem" },
				{ "slug": "section", "name": "Section heading", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "display", "name": "Display", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } },
				{ "slug": "hero", "name": "Hero", "size": "3.75rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } }
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "10", "name": "Tight", "size": "0.5rem" },
				{ "slug": "20", "name": "Snug", "size": "0.75rem" },
				{ "slug": "30", "name": "Base", "size": "1rem" },
				{ "slug": "40", "name": "Card", "size": "1.5rem" },
				{ "slug": "50", "name": "Block", "size": "2.5rem" },
				{ "slug": "60", "name": "Section", "size": "5rem" },
				{ "slug": "70", "name": "Chapter", "size": "8rem" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "flat", "name": "Flat", "shadow": "none" },
				{ "slug": "card", "name": "Card", "shadow": "0 1px 2px rgba(12,12,37,0.06), 0 8px 24px -12px rgba(12,12,37,0.18)" },
				{ "slug": "lifted", "name": "Lifted", "shadow": "0 2px 4px rgba(12,12,37,0.06), 0 18px 40px -16px rgba(12,12,37,0.28)" },
				{ "slug": "glow", "name": "Brand glow", "shadow": "0 0 0 1px rgba(70,67,186,0.14), 0 18px 44px -18px rgba(70,67,186,0.45)" }
			]
		},
		"dimensions": { "minHeight": true },
		"position": { "sticky": true },
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--background, #FCFBFE)",
			"text": "var(--foreground, #0C0C25)"
		},
		"typography": {
			"fontFamily": "var(--font-sans, \"Inter\", ui-sans-serif, system-ui, sans-serif)",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "0.75rem", "right": "0.75rem" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--primary, #4643BA)" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--font-sans, \"Inter\", ui-sans-serif, system-ui, sans-serif)",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "var(--bbi-heading-tracking, -0.02em)"
				}
			},
			"button": {
				"color": {
					"background": "var(--primary, #4643BA)",
					"text": "var(--primary-foreground, #FFFFFF)"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.65rem", "bottom": "0.65rem", "left": "1.35rem", "right": "1.35rem" } },
				"typography": { "fontWeight": "600" }
			}
		},
		"blocks": {
			"core/quote": {
				"border": { "left": { "color": "var(--primary, #4643BA)", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } }
			},
			"core/separator": {
				"color": { "text": "var(--border, rgba(43,40,113,0.18))" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "full-width", "title": "Full width, no sidebar", "postTypes": [ "page", "post", "bbi_idea" ] },
		{ "name": "landing", "title": "Landing page, no header or footer chrome", "postTypes": [ "page" ] }
	]
}
